{
  "name": "WAN 2.2 + UltraSharp Upscale",
  "description": "Pipeline complet : génération optimale + upscaling adaptatif 4x UltraSharp + resize précis",
  "version": "3.5.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["pipeline", "cinemagraph", "upscale", "complete"],

  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Image d'entrée"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Prompt de génération"
    },
    "negative_prompt": {
      "type": "string",
      "default": "static, frozen, blurry, distorted",
      "description": "Éléments à éviter"
    },
    "steps_generation": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Steps pour la génération"
    },
    "steps_upscale": {
      "type": "integer",
      "default": 15,
      "min": 5,
      "max": 30,
      "description": "Steps pour l'upscaling"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "CFG scale"
    },
    "scale_factor": {
      "type": "float",
      "default": 2.0,
      "min": 1.5,
      "max": 4.0,
      "description": "Facteur d'upscaling"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 240,
      "description": "Nombre de frames (240 = 10s @ 24fps)"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 60,
      "description": "FPS de sortie (60 pour slow-motion)"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    },
    "width": {
      "type": "integer",
      "default": 832,
      "min": 64,
      "max": 3840,
      "description": "Largeur de la vidéo"
    },
    "height": {
      "type": "integer",
      "default": 480,
      "min": 64,
      "max": 2160,
      "description": "Hauteur de génération WAN 2.2"
    },
    "target_width": {
      "type": "integer",
      "default": 1920,
      "min": 64,
      "max": 7680,
      "description": "Largeur finale après upscale"
    },
    "target_height": {
      "type": "integer",
      "default": 1080,
      "min": 64,
      "max": 4320,
      "description": "Hauteur finale après upscale"
    },
    "enable_vae_tiling": {
      "type": "boolean",
      "default": false,
      "description": "Activer VAE tiling pour grandes résolutions"
    },
    "shift": {
      "type": "float",
      "default": 5.0,
      "min": 3.0,
      "max": 10.0,
      "description": "Force du changement temporel (calculé depuis motion_intensity/noise_level/denoise)"
    },
    "riflex_freq_index": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 2,
      "description": "Cohérence temporelle: 0=créatif, 1=équilibré, 2=stable (depuis consistency)"
    },
    "pingpong": {
      "type": "boolean",
      "default": false,
      "description": "Boucle aller-retour pour transition fluide (depuis loop_smooth)"
    }
  },

  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model": "{checkpoint_path}",
        "base_precision": "fp16",
        "quantization": "disabled",
        "load_device": "main_device"
      }
    },
    "3": {
      "class_type": "WanVideoVAELoader",
      "inputs": {
        "model_name": "{vae_name}",
        "precision": "bf16"
      }
    },
    "4": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "clip-vit-large-patch14-336.safetensors"
      }
    },
    "5": {
      "class_type": "WanVideoTextEncodeCached",
      "inputs": {
        "model_name": "t5/umt5_xxl_fp16.safetensors",
        "precision": "bf16",
        "positive_prompt": "{prompt}",
        "negative_prompt": "{negative_prompt}",
        "quantization": "disabled",
        "use_disk_cache": true,
        "device": "gpu"
      }
    },
    "7": {
      "class_type": "WanVideoEncode",
      "inputs": {
        "vae": ["3", 0],
        "image": ["1", 0],
        "enable_vae_tiling": "{enable_vae_tiling}",
        "tile_x": 272,
        "tile_y": 272,
        "tile_stride_x": 144,
        "tile_stride_y": 128,
        "temporal_compress_level": 0,
        "spatial_compress_level": 0
      }
    },
    "7b": {
      "class_type": "WanVideoEmptyEmbeds",
      "inputs": {
        "extra_latents": ["7", 0],
        "width": "{width}",
        "height": "{height}",
        "num_frames": "{frames}"
      }
    },
    "8": {
      "class_type": "WanVideoSampler",
      "inputs": {
        "model": ["2", 0],
        "image_embeds": ["7b", 0],
        "text_embeds": ["5", 0],
        "steps": "{steps_generation}",
        "cfg": "{cfg_scale}",
        "shift": "{shift}",
        "seed": "{seed}",
        "force_offload": false,
        "scheduler": "unipc",
        "riflex_freq_index": "{riflex_freq_index}"
      },
      "_comment": "shift et riflex_freq_index calculés depuis motion_intensity/denoise/consistency"
    },
    "9": {
      "class_type": "WanVideoDecode",
      "inputs": {
        "vae": ["3", 0],
        "samples": ["8", 0],
        "enable_vae_tiling": "{enable_vae_tiling}",
        "tile_x": 272,
        "tile_y": 272,
        "tile_stride_x": 144,
        "tile_stride_y": 128
      }
    },
    "10": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "4x-UltraSharp.pth"
      }
    },
    "11": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": ["10", 0],
        "image": ["9", 0]
      }
    },
    "11b": {
      "class_type": "ImageScale",
      "inputs": {
        "image": ["11", 0],
        "width": "{target_width}",
        "height": "{target_height}",
        "upscale_method": "lanczos",
        "crop": "disabled"
      }
    },
    "12": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_upscaled",
        "format": "video/h264-mp4",
        "crf": 18,
        "pingpong": "{pingpong}",
        "save_output": true,
        "images": ["11b", 0]
      },
      "_comment": "pingpong=true pour boucle fluide (depuis loop_smooth)"
    }
  },

  "outputs": {
    "video": {
      "node": "12",
      "output": 0,
      "description": "Cinemagraph upscalé"
    }
  },

  "metadata": {
    "comfyui_version": ">=0.3.0",
    "wanvideowrapper_version": "kijai_nov2024",
    "tags": ["pipeline", "cinemagraph", "upscale", "complete"],
    "required_nodes": [
      "LoadImage",
      "WanVideoModelLoader",
      "WanVideoVAELoader",
      "CLIPVisionLoader",
      "WanVideoTextEncodeCached",
      "WanVideoEncode",
      "WanVideoEmptyEmbeds",
      "WanVideoSampler",
      "WanVideoDecode",
      "UpscaleModelLoader",
      "ImageUpscaleWithModel",
      "VHS_VideoCombine"
    ],
    "changelog": {
      "v3.5.0": "FEATURE: Implémentation paramètres frontend (shift, riflex_freq_index, pingpong) - contrôle motion_intensity/denoise/consistency/loop_smooth",
      "v3.2.0": "Fix load_device: gpu → main_device (valeurs API WanVideoWrapper: main_device/offload_device uniquement)",
      "v3.1.0": "Optimisation GPU : load_device=gpu + force_offload=false (avec 95GB VRAM, accélération ~3-5x)",
      "v3.0.0": "Système upscale adaptatif UltraSharp 4x avec node 11b (ImageScale resize vers target exacte)",
      "v2.0.0": "BREAKING: Remplacé WanVideoImageToVideoEncode par WanVideoEncode + WanVideoEmptyEmbeds (fix erreur 48/96 canaux)"
    }
  }
}
