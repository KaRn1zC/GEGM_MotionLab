{
  "name": "WAN 2.2 Image-to-Video",
  "description": "Génération de cinemagraphs avec WAN 2.2 5B - Version corrigée compatible wrapper récent",
  "version": "4.5.1",
  "author": "GEGM MotionLab",
  "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],

  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Nom du fichier image d'entrée (doit être dans ComfyUI/input/)"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Description textuelle de l'animation souhaitée"
    },
    "negative_prompt": {
      "type": "string",
      "default": "camera shake, shaky footage, jitter, flickering, morphing shapes, warping artifacts, blurry, noise grain, choppy motion, inconsistent lighting, rapid changes, distortion",
      "description": "Éléments à éviter dans l'animation"
    },
    "steps": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Nombre de steps de dénoising"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "Échelle de guidance CFG (ajusté par color_preservation)"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 240,
      "description": "Nombre de frames (240 = 10s @ 24fps)"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 60,
      "description": "Frames par seconde (60 pour slow-motion)"
    },
    "width": {
      "type": "integer",
      "default": 832,
      "min": 64,
      "max": 3840,
      "description": "Largeur de la vidéo (sera ajustée automatiquement)"
    },
    "height": {
      "type": "integer",
      "default": 480,
      "min": 64,
      "max": 2160,
      "description": "Hauteur de la vidéo (sera ajustée automatiquement)"
    },
    "shift": {
      "type": "float",
      "default": 5.0,
      "min": 3.0,
      "max": 10.0,
      "description": "Force du changement temporel (calculé depuis motion_intensity/noise_level/denoise)"
    },
    "riflex_freq_index": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 2,
      "description": "Cohérence temporelle: 0=créatif, 1=équilibré, 2=stable (depuis consistency)"
    }
  },

  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model": "{checkpoint_path}",
        "base_precision": "fp16",
        "quantization": "disabled",
        "load_device": "main_device"
      }
    },
    "3": {
      "class_type": "WanVideoVAELoader",
      "inputs": {
        "model_name": "{vae_name}",
        "precision": "bf16"
      }
    },
    "4": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "clip-vit-large-patch14-336.safetensors"
      }
    },
    "5": {
      "class_type": "WanVideoTextEncodeCached",
      "inputs": {
        "model_name": "t5/umt5_xxl_fp16.safetensors",
        "precision": "bf16",
        "positive_prompt": "{prompt}",
        "negative_prompt": "{negative_prompt}",
        "quantization": "disabled",
        "use_disk_cache": true,
        "device": "gpu"
      }
    },
    "7": {
      "class_type": "WanVideoEncode",
      "inputs": {
        "vae": ["3", 0],
        "image": ["1", 0],
        "enable_vae_tiling": "{enable_vae_tiling}",
        "tile_x": 272,
        "tile_y": 272,
        "tile_stride_x": 144,
        "tile_stride_y": 128,
        "temporal_compress_level": 0,
        "spatial_compress_level": 0
      }
    },
    "7b": {
      "class_type": "WanVideoEmptyEmbeds",
      "inputs": {
        "extra_latents": ["7", 0],
        "width": "{width}",
        "height": "{height}",
        "num_frames": "{frames}"
      }
    },
    "8": {
      "class_type": "WanVideoSampler",
      "inputs": {
        "model": ["2", 0],
        "image_embeds": ["7b", 0],
        "text_embeds": ["5", 0],
        "steps": "{steps}",
        "cfg": "{cfg_scale}",
        "shift": "{shift}",
        "seed": "{seed}",
        "force_offload": false,
        "scheduler": "unipc",
        "riflex_freq_index": "{riflex_freq_index}"
      },
      "_comment": "shift et riflex_freq_index calculés depuis motion_intensity/denoise/consistency"
    },
    "9": {
      "class_type": "WanVideoDecode",
      "inputs": {
        "vae": ["3", 0],
        "samples": ["8", 0],
        "enable_vae_tiling": "{enable_vae_tiling}",
        "tile_x": 272,
        "tile_y": 272,
        "tile_stride_x": 144,
        "tile_stride_y": 128
      }
    },
    "10": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_cinemagraph",
        "format": "video/h264-mp4",
        "crf": 18,
        "pingpong": false,
        "save_output": true,
        "images": ["9", 0]
      },
      "_comment": "pingpong=false (pas d'effet miroir aller-retour)"
    }
  },

  "outputs": {
    "video": {
      "node": "10",
      "output": 0,
      "description": "Cinemagraph généré"
    }
  },

  "metadata": {
    "comfyui_version": ">=0.3.0",
    "wanvideowrapper_version": "kijai_nov2024",
    "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
    "required_nodes": [
      "LoadImage",
      "WanVideoModelLoader",
      "WanVideoVAELoader",
      "WanVideoTextEncodeCached",
      "WanVideoEncode",
      "WanVideoEmptyEmbeds",
      "WanVideoSampler",
      "WanVideoDecode",
      "VHS_VideoCombine"
    ],
    "changelog": {
      "v4.5.1": "FIX: pingpong désactivé (false) pour vraie boucle seamless - suppression paramètre dynamique",
      "v4.5.0": "FEATURE: Implémentation paramètres frontend (shift, riflex_freq_index, pingpong) - contrôle motion_intensity/denoise/consistency/loop_smooth",
      "v4.2.0": "Fix load_device: gpu → main_device (valeurs API WanVideoWrapper: main_device/offload_device uniquement)",
      "v4.1.0": "Optimisation GPU : load_device=gpu + force_offload=false (avec 95GB VRAM, accélération ~3-5x)",
      "v4.0.0": "BREAKING: Remplacé WanVideoImageToVideoEncode par WanVideoEncode + WanVideoEmptyEmbeds (fix erreur 48/96 canaux)"
    }
  }
}
