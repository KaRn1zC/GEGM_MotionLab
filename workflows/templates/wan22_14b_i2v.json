{
  "name": "WAN 2.2 14B Image-to-Video",
  "description": "Pipeline 14B: génération directe sans upscale (résolutions ≤ 720p)",
  "version": "1.1.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["pipeline", "cinemagraph", "14B", "i2v"],

  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Image d'entrée"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Prompt de génération"
    },
    "negative_prompt": {
      "type": "string",
      "default": "static, frozen, blurry, distorted",
      "description": "Éléments à éviter"
    },
    "steps_generation": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Steps pour la génération"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "CFG scale"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 240,
      "description": "Nombre de frames (240 = 10s @ 24fps)"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 60,
      "description": "FPS de sortie (60 pour slow-motion)"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    },
    "width": {
      "type": "integer",
      "default": 832,
      "min": 64,
      "max": 1280,
      "description": "Largeur de la vidéo (max 720p)"
    },
    "height": {
      "type": "integer",
      "default": 480,
      "min": 64,
      "max": 720,
      "description": "Hauteur de génération WAN 2.2 14B (max 720p)"
    },
    "enable_vae_tiling": {
      "type": "boolean",
      "default": false,
      "description": "Activer VAE tiling pour grandes résolutions"
    }
  },

  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model": "{checkpoint_path}",
        "base_precision": "bf16",
        "quantization": "disabled",
        "load_device": "offload_device"
      }
    },
    "3": {
      "class_type": "WanVideoVAELoader",
      "inputs": {
        "model_name": "{vae_name}",
        "precision": "bf16"
      }
    },
    "4": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "clip-vit-large-patch14-336.safetensors"
      }
    },
    "5": {
      "class_type": "WanVideoTextEncodeCached",
      "inputs": {
        "model_name": "t5/umt5_xxl_fp16.safetensors",
        "precision": "bf16",
        "positive_prompt": "{prompt}",
        "negative_prompt": "{negative_prompt}",
        "quantization": "disabled",
        "use_disk_cache": true,
        "device": "gpu"
      }
    },
    "7": {
      "class_type": "WanVideoImageToVideoEncode",
      "inputs": {
        "vae": ["3", 0],
        "image": ["1", 0],
        "width": "{width}",
        "height": "{height}",
        "num_frames": "{frames}",
        "temporal_compress_level": 0,
        "spatial_compress_level": 1,
        "start_latent_strength": 1.0,
        "end_latent_strength": 1.0,
        "noise_aug_strength": 0.0,
        "force_offload": true,
        "enable_vae_tiling": "{enable_vae_tiling}"
      }
    },
    "8": {
      "class_type": "WanVideoSampler",
      "inputs": {
        "model": ["2", 0],
        "image_embeds": ["7", 0],
        "text_embeds": ["5", 0],
        "steps": "{steps_generation}",
        "cfg": "{cfg_scale}",
        "shift": 5.0,
        "seed": "{seed}",
        "force_offload": true,
        "scheduler": "unipc",
        "riflex_freq_index": 0
      }
    },
    "9": {
      "class_type": "WanVideoDecode",
      "inputs": {
        "vae": ["3", 0],
        "samples": ["8", 0],
        "enable_vae_tiling": "{enable_vae_tiling}",
        "tile_x": 272,
        "tile_y": 272,
        "tile_stride_x": 144,
        "tile_stride_y": 128
      }
    },
    "12": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_14b",
        "format": "video/h264-mp4",
        "crf": 18,
        "pingpong": false,
        "save_output": true,
        "images": ["9", 0]
      }
    }
  },

  "outputs": {
    "video": {
      "node": "12",
      "output": 0,
      "description": "Cinemagraph 14B"
    }
  },

  "metadata": {
    "comfyui_version": ">=0.3.0",
    "wanvideowrapper_version": "kijai_dec2024",
    "tags": ["pipeline", "cinemagraph", "14B", "i2v"],
    "required_nodes": [
      "LoadImage",
      "WanVideoModelLoader",
      "WanVideoVAELoader",
      "CLIPVisionLoader",
      "WanVideoTextEncodeCached",
      "WanVideoImageToVideoEncode",
      "WanVideoSampler",
      "WanVideoDecode",
      "VHS_VideoCombine"
    ],
    "changelog": {
      "v1.1.0": "Ajout paramètres requis WanVideoImageToVideoEncode (start/end_latent_strength, noise_aug_strength, force_offload)",
      "v1.0.0": "Workflow 14B sans upscale utilisant WanVideoImageToVideoEncode (architecture officielle)"
    }
  }
}
