{
  "name": "WAN 2.2 Image-to-Video",
  "description": "Génération de cinemagraphs avec WAN 2.2 I2V 14B - Version complète",
  "version": "2.0.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
  
  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Nom du fichier image d'entrée (doit être dans ComfyUI/input/)"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Description textuelle de l'animation souhaitée"
    },
    "negative_prompt": {
      "type": "string",
      "default": "static, frozen, still, no movement, blurry, distorted",
      "description": "Éléments à éviter dans l'animation"
    },
    "steps": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Nombre de steps de dénoising (plus = meilleure qualité)"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "Échelle de guidance CFG (plus = suit mieux le prompt)"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 48,
      "description": "Nombre de frames de la vidéo"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 30,
      "description": "Frames par seconde"
    },
    "noise_level": {
      "type": "string",
      "default": "high",
      "enum": ["high", "low"],
      "description": "Niveau de bruit (high=dynamique, low=subtil)"
    },
    "motion_bucket_id": {
      "type": "integer",
      "default": 127,
      "min": 1,
      "max": 255,
      "description": "Intensité du mouvement (plus = plus de mouvement)"
    },
    "augmentation_level": {
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "description": "Niveau d'augmentation de l'image"
    }
  },
  
  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model": "{model_name}",
        "device": "cuda",
        "dtype": "bf16"
      }
    },
    "3": {
      "class_type": "WanVideoConditioning",
      "inputs": {
        "model": ["2", 0],
        "prompt": "{prompt}",
        "negative_prompt": "{negative_prompt}"
      }
    },
    "4": {
      "class_type": "WanVideoImageToVideoSampler",
      "inputs": {
        "model": ["2", 0],
        "conditioning": ["3", 0],
        "image": ["1", 0],
        "num_frames": "{frames}",
        "steps": "{steps}",
        "cfg": "{cfg_scale}",
        "seed": "{seed}",
        "width": 512,
        "height": 512,
        "motion_bucket_id": "{motion_bucket_id}",
        "fps": "{fps}"
      }
    },
    "5": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_cinemagraph",
        "format": "video/h264-mp4",
        "pingpong": false,
        "save_output": true,
        "images": ["4", 0]
      }
    }
  },
  
  "outputs": {
    "video": {
      "node": "9",
      "output": 0,
      "description": "Cinemagraph généré"
    }
  },
  
  "metadata": {
    "comfyui_version": ">=0.2.0",
    "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
    "required_nodes": [
      "LoadImage",
      "CLIPTextEncode",
      "CheckpointLoaderSimple",
      "VAEEncode",
      "VAEDecode",
      "KSampler",
      "VideoLinearCFGGuidance",
      "VHS_VideoCombine"
    ],
    "required_models": [
      "wan2.2-i2v-a14b/high_noise_model.safetensors",
      "wan2.2-i2v-a14b/low_noise_model.safetensors"
    ]
  }
}
