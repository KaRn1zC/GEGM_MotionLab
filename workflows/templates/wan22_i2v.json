{
  "name": "WAN 2.2 Image-to-Video",
  "description": "Génération de cinemagraphs avec WAN 2.2 I2V 14B - Version complète",
  "version": "2.0.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
  
  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Nom du fichier image d'entrée (doit être dans ComfyUI/input/)"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Description textuelle de l'animation souhaitée"
    },
    "negative_prompt": {
      "type": "string",
      "default": "static, frozen, still, no movement, blurry, distorted",
      "description": "Éléments à éviter dans l'animation"
    },
    "steps": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Nombre de steps de dénoising (plus = meilleure qualité)"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "Échelle de guidance CFG (plus = suit mieux le prompt)"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 48,
      "description": "Nombre de frames de la vidéo"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 30,
      "description": "Frames par seconde"
    },
    "noise_level": {
      "type": "string",
      "default": "high",
      "enum": ["high", "low"],
      "description": "Niveau de bruit (high=dynamique, low=subtil)"
    },
    "motion_bucket_id": {
      "type": "integer",
      "default": 127,
      "min": 1,
      "max": 255,
      "description": "Intensité du mouvement (plus = plus de mouvement)"
    },
    "augmentation_level": {
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "description": "Niveau d'augmentation de l'image"
    }
  },
  
  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{model_name}/wan2.2_ti2v_5B_fp16.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "note": "5B: fichier unique, 14B: high_noise sera utilisé"
      }
    },
    "3": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{model_name}/wan2.2_i2v_low_noise_14B_fp16.safetensors",
        "weight_dtype": "default"
      },
      "_meta": {
        "note": "14B uniquement: low noise model"
      }
    },
    "4": {
      "class_type": "DualCLIPLoader",
      "inputs": {
        "clip_name1": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "clip_name2": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan22"
      }
    },
    "5": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan2.2_vae.safetensors"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{prompt}",
        "clip": ["4", 0]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{negative_prompt}",
        "clip": ["4", 0]
      }
    },
    "8": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": {
        "image": ["1", 0],
        "width": 512,
        "height": 512,
        "length": "{frames}",
        "batch_size": 1
      }
    },
    "9": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "{seed}"
      }
    },
    "10": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "11": {
      "class_type": "BasicScheduler",
      "inputs": {
        "scheduler": "normal",
        "steps": "{steps}",
        "denoise": 1.0,
        "model": ["2", 0]
      }
    },
    "12": {
      "class_type": "BasicGuider",
      "inputs": {
        "model": ["2", 0],
        "conditioning": ["6", 0]
      }
    },
    "13": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["9", 0],
        "guider": ["12", 0],
        "sampler": ["10", 0],
        "sigmas": ["11", 0],
        "latent_image": ["8", 0]
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["13", 0],
        "vae": ["5", 0]
      }
    },
    "15": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_cinemagraph",
        "format": "video/h264-mp4",
        "pingpong": false,
        "save_output": true,
        "images": ["14", 0]
      }
    }
  },
  
  "outputs": {
    "video": {
      "node": "9",
      "output": 0,
      "description": "Cinemagraph généré"
    }
  },
  
  "metadata": {
    "comfyui_version": ">=0.2.0",
    "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
    "required_nodes": [
      "LoadImage",
      "CLIPTextEncode",
      "CheckpointLoaderSimple",
      "VAEEncode",
      "VAEDecode",
      "KSampler",
      "VideoLinearCFGGuidance",
      "VHS_VideoCombine"
    ],
    "required_models": [
      "wan2.2-i2v-a14b/high_noise_model.safetensors",
      "wan2.2-i2v-a14b/low_noise_model.safetensors"
    ]
  }
}
