{
  "name": "WAN 2.2 Image-to-Video",
  "description": "Génération de cinemagraphs avec WAN 2.2 I2V 14B - Version compatible Kijai Oct 2025",
  "version": "3.0.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
  
  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Nom du fichier image d'entrée (doit être dans ComfyUI/input/)"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Description textuelle de l'animation souhaitée"
    },
    "negative_prompt": {
      "type": "string",
      "default": "static, frozen, still, no movement, blurry, distorted",
      "description": "Éléments à éviter dans l'animation"
    },
    "steps": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Nombre de steps de dénoising"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "Échelle de guidance CFG"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 48,
      "description": "Nombre de frames de la vidéo"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 30,
      "description": "Frames par seconde"
    }
  },
  
  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model": "wan2.2-i2v-a14b",
        "device": "cuda",
        "dtype": "bf16"
      }
    },
    "3": {
      "class_type": "WanVideoTextEncode",
      "inputs": {
        "model": ["2", 0],
        "prompt": "{prompt}"
      }
    },
    "4": {
      "class_type": "WanVideoTextEncode",
      "inputs": {
        "model": ["2", 0],
        "prompt": "{negative_prompt}"
      }
    },
    "5": {
      "class_type": "WanVideoImageToVideoEncode",
      "inputs": {
        "model": ["2", 0],
        "image": ["1", 0]
      }
    },
    "6": {
      "class_type": "WanVideoSampler",
      "inputs": {
        "model": ["2", 0],
        "positive": ["3", 0],
        "negative": ["4", 0],
        "latent": ["5", 0],
        "steps": "{steps}",
        "cfg": "{cfg_scale}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "seed": "{seed}"
      }
    },
    "7": {
      "class_type": "WanVideoDecode",
      "inputs": {
        "model": ["2", 0],
        "samples": ["6", 0]
      }
    },
    "8": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_cinemagraph",
        "format": "video/h264-mp4",
        "pingpong": false,
        "save_output": true,
        "images": ["7", 0]
      }
    }
  },
  
  "outputs": {
    "video": {
      "node": "8",
      "output": 0,
      "description": "Cinemagraph généré"
    }
  },
  
  "metadata": {
    "comfyui_version": ">=0.3.0",
    "wanvideowrapper_version": "kijai_oct2025",
    "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
    "required_nodes": [
      "LoadImage",
      "WanVideoModelLoader",
      "WanVideoTextEncode",
      "WanVideoImageToVideoEncode",
      "WanVideoSampler",
      "WanVideoDecode",
      "VHS_VideoCombine"
    ]
  }
}
