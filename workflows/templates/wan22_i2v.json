{
  "name": "WAN 2.2 Image-to-Video",
  "description": "Génération de cinemagraphs avec WAN 2.2 I2V 14B - Version compatible Kijai Oct 2025",
  "version": "3.0.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
  
  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Nom du fichier image d'entrée (doit être dans ComfyUI/input/)"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Description textuelle de l'animation souhaitée"
    },
    "negative_prompt": {
      "type": "string",
      "default": "static, frozen, still, no movement, blurry, distorted",
      "description": "Éléments à éviter dans l'animation"
    },
    "steps": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Nombre de steps de dénoising"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "Échelle de guidance CFG"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 48,
      "description": "Nombre de frames de la vidéo"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 30,
      "description": "Frames par seconde"
    },
    "width": {
      "type": "integer",
      "default": 832,
      "min": 64,
      "max": 3840,
      "description": "Largeur de la vidéo (sera ajustée automatiquement)"
    },
    "height": {
      "type": "integer",
      "default": 480,
      "min": 64,
      "max": 2160,
      "description": "Hauteur de la vidéo (sera ajustée automatiquement)"
    }
  },

  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model": "{checkpoint_path}",
        "base_precision": "bf16",
        "quantization": "disabled",
        "load_device": "offload_device"
      }
    },
    "3": {
      "class_type": "WanVideoVAELoader",
      "inputs": {
        "vae_name": "Wan2.2_VAE.pth",
        "precision": "bf16"
      }
    },
    "4": {
      "class_type": "CLIPVisionLoader",
      "inputs": {
        "clip_name": "clip-vit-large-patch14-336.safetensors"
      }
    },
    "5": {
      "class_type": "WanVideoTextEncodeCached",
      "inputs": {
        "model_name": "t5/umt5-xxl-enc-bf16.pth",
        "precision": "bf16",
        "positive_prompt": "{prompt}",
        "negative_prompt": "{negative_prompt}",
        "quantization": "disabled",
        "use_disk_cache": true,
        "device": "gpu"
      }
    },
    "6": {
      "class_type": "WanVideoClipVisionEncode",
      "inputs": {
        "clip_vision": ["4", 0],
        "image_1": ["1", 0],
        "strength_1": 1.0,
        "strength_2": 1.0,
        "crop": "center",
        "combine_embeds": "average",
        "force_offload": true
      }
    },
    "7": {
      "class_type": "WanVideoImageToVideoEncode",
      "inputs": {
        "width": "{width}",
        "height": "{height}",
        "num_frames": "{frames}",
        "noise_aug_strength": 0.0,
        "start_latent_strength": 1.0,
        "end_latent_strength": 1.0,
        "force_offload": true,
        "vae": ["3", 0],
        "clip_embeds": ["6", 0],
        "start_image": ["1", 0]
      }
    },
    "8": {
      "class_type": "WanVideoSampler",
      "inputs": {
        "model": ["2", 0],
        "image_embeds": ["7", 0],
        "text_embeds": ["5", 0],
        "steps": "{steps}",
        "cfg": "{cfg_scale}",
        "shift": 5.0,
        "seed": "{seed}",
        "force_offload": true,
        "scheduler": "unipc",
        "riflex_freq_index": 0
      }
    },
    "9": {
      "class_type": "WanVideoDecode",
      "inputs": {
        "vae": ["3", 0],
        "samples": ["8", 0],
        "enable_vae_tiling": false,
        "tile_x": 272,
        "tile_y": 272,
        "tile_stride_x": 144,
        "tile_stride_y": 128
      }
    },
    "10": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_cinemagraph",
        "format": "video/h264-mp4",
        "pingpong": false,
        "save_output": true,
        "images": ["9", 0]
      }
    }
  },
  
  "outputs": {
    "video": {
      "node": "10",
      "output": 0,
      "description": "Cinemagraph généré"
    }
  },
  
  "metadata": {
    "comfyui_version": ">=0.3.0",
    "wanvideowrapper_version": "kijai_oct2025",
    "tags": ["cinemagraph", "i2v", "wan2.2", "animation"],
    "required_nodes": [
      "LoadImage",
      "WanVideoModelLoader",
      "WanVideoTextEncode",
      "WanVideoImageToVideoEncode",
      "WanVideoSampler",
      "WanVideoDecode",
      "VHS_VideoCombine"
    ]
  }
}
