{
  "name": "LTX 2.3 22B Image-to-Video",
  "description": "Full path officiel LTX 2.3 22B — Pipeline AV + MultimodalGuider + ClownSampler_Beta",
  "version": "12.0.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["cinemagraph", "i2v", "ltx2.3", "animation"],
  "model_family": "ltx23",

  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Nom du fichier image d'entree"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Description textuelle de l'animation souhaitee"
    },
    "negative_prompt": {
      "type": "string",
      "default": "",
      "description": "Elements a eviter"
    },
    "steps": {
      "type": "integer",
      "default": 15,
      "min": 15,
      "max": 15,
      "description": "Steps force a 15 (valeur officielle LTX 2.3 22B, override backend)"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed (-1 = aleatoire)"
    },
    "frames": {
      "type": "integer",
      "default": 65,
      "min": 9,
      "max": 241,
      "description": "Nombre de frames generees (N*8+1), crossfade seamless en post-processing"
    },
    "fps": {
      "type": "integer",
      "default": 24,
      "min": 4,
      "max": 50,
      "description": "Frames par seconde"
    },
    "width": {
      "type": "integer",
      "default": 960,
      "min": 64,
      "max": 1920,
      "description": "Largeur de generation (multiple de 32)"
    },
    "height": {
      "type": "integer",
      "default": 544,
      "min": 64,
      "max": 1088,
      "description": "Hauteur de generation (multiple de 32)"
    },
    "i2v_strength": {
      "type": "float",
      "default": 0.7,
      "min": 0.0,
      "max": 1.0,
      "description": "Force du conditionnement image dans le latent (0.7 officiel Lightricks)"
    },
    "cfg_scale": {
      "type": "float",
      "default": 3.0,
      "min": 1.0,
      "max": 20.0,
      "description": "CFG guidance video (3.0 officiel Lightricks 22B)"
    }
  },

  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "14": {
      "class_type": "LTXVPreprocess",
      "inputs": {
        "image": ["1", 0],
        "img_compression": 18
      },
      "_comment": "CRF H.264 preprocessing (ComfyUI core, param verifie: img_compression)"
    },

    "2": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "{checkpoint_path}"
      }
    },
    "18": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": ["2", 0],
        "lora_name": "{lora_path}",
        "strength_model": 0.2
      },
      "_comment": "LoRA distilled strength=0.2 — full path officiel Lightricks"
    },
    "3": {
      "class_type": "LTXAVTextEncoderLoader",
      "inputs": {
        "text_encoder": "{text_encoder_flat}",
        "ckpt_name": "{checkpoint_path}",
        "device": "default"
      }
    },

    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{prompt}",
        "clip": ["3", 0]
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{negative_prompt}",
        "clip": ["3", 0]
      }
    },
    "15": {
      "class_type": "LTXVConditioning",
      "inputs": {
        "positive": ["4", 0],
        "negative": ["5", 0],
        "frame_rate": "{fps}"
      },
      "_comment": "Injecte frame_rate dans conditioning (ComfyUI core)"
    },

    "13": {
      "class_type": "EmptyLTXVLatentVideo",
      "inputs": {
        "width": "{width}",
        "height": "{height}",
        "length": "{frames}",
        "batch_size": 1
      }
    },
    "16": {
      "class_type": "LTXVImgToVideoConditionOnly",
      "inputs": {
        "vae": ["2", 2],
        "image": ["14", 0],
        "latent": ["13", 0],
        "strength": "{i2v_strength}"
      },
      "_comment": "Encode image CRF-preprocessee dans latent frame 0 + noise_mask (strength=0.7 officiel)"
    },
    "20": {
      "class_type": "LTXVAudioVAELoader",
      "inputs": {
        "ckpt_name": "{checkpoint_path}"
      },
      "_comment": "Charge le VAE audio depuis le meme checkpoint (modele multimodal AV)"
    },
    "21": {
      "class_type": "LTXVEmptyLatentAudio",
      "inputs": {
        "frames_number": "{frames}",
        "frame_rate": "{fps}",
        "batch_size": 1,
        "audio_vae": ["20", 0]
      },
      "_comment": "Latent audio vide — DOIT matcher les dimensions video (frames/fps) pour coherence NestedTensor"
    },
    "22": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": ["16", 0],
        "audio_latent": ["21", 0]
      },
      "_comment": "Pack video+audio en NestedTensor — format attendu par le modele LTX 2.3"
    },

    "23": {
      "class_type": "GuiderParameters",
      "inputs": {
        "modality": "AUDIO",
        "cfg": 7.0,
        "stg": 1.0,
        "perturb_attn": true,
        "rescale": 0.7,
        "modality_scale": 3.0,
        "skip_step": 0,
        "cross_attn": true
      },
      "_comment": "Parametres guidance AUDIO — valeurs officielles Lightricks 22B"
    },
    "24": {
      "class_type": "GuiderParameters",
      "inputs": {
        "modality": "VIDEO",
        "cfg": "{cfg_scale}",
        "stg": 1.0,
        "perturb_attn": true,
        "rescale": 0.9,
        "modality_scale": 3.0,
        "skip_step": 0,
        "cross_attn": true,
        "parameters": ["23", 0]
      },
      "_comment": "Parametres guidance VIDEO — chaines depuis AUDIO (modele multimodal)"
    },
    "6": {
      "class_type": "MultimodalGuider",
      "inputs": {
        "model": ["18", 0],
        "positive": ["15", 0],
        "negative": ["15", 1],
        "parameters": ["24", 0],
        "skip_blocks": "28"
      },
      "_comment": "Guider multimodal officiel — gere le packing/unpacking AV en interne"
    },

    "10": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "{seed}"
      }
    },
    "11": {
      "class_type": "ClownSampler_Beta",
      "inputs": {
        "eta": 0.25,
        "sampler_name": "exponential/res_2s",
        "seed": "{seed}",
        "bongmath": true
      },
      "_comment": "Solveur ODE haute qualite (RES4LYF) — full path officiel. eta=0.25 pour SDE temporel"
    },
    "12": {
      "class_type": "LTXVScheduler",
      "inputs": {
        "steps": "{steps}",
        "max_shift": 2.05,
        "base_shift": 0.95,
        "stretch": true,
        "terminal": 0.1,
        "latent": ["22", 0]
      },
      "_comment": "Scheduler avec latent AV — ajuste les sigmas selon les dimensions du tenseur"
    },
    "17": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["10", 0],
        "guider": ["6", 0],
        "sampler": ["11", 0],
        "sigmas": ["12", 0],
        "latent_image": ["22", 0]
      },
      "_comment": "Sampling sur le latent AV packe"
    },

    "25": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": ["17", 0]
      },
      "_comment": "Separe le latent AV debruite → video seule (output 0)"
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["25", 0],
        "vae": ["2", 2]
      }
    },
    "9": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "ltx23_cinemagraph",
        "format": "video/h264-mp4",
        "crf": 18,
        "pingpong": false,
        "save_output": true,
        "images": ["8", 0]
      }
    }
  },

  "outputs": {
    "video": {
      "node": "9",
      "output": 0,
      "description": "Cinemagraph anime"
    }
  },

  "metadata": {
    "comfyui_version": ">=0.16.1",
    "ltxvideo_version": "lightricks_mar2026",
    "tags": ["cinemagraph", "i2v", "ltx2.3", "animation"],
    "required_nodes": [
      "LoadImage",
      "LTXVPreprocess",
      "CheckpointLoaderSimple",
      "LoraLoaderModelOnly",
      "LTXAVTextEncoderLoader",
      "CLIPTextEncode",
      "LTXVConditioning",
      "EmptyLTXVLatentVideo",
      "LTXVImgToVideoConditionOnly",
      "LTXVAudioVAELoader",
      "LTXVEmptyLatentAudio",
      "LTXVConcatAVLatent",
      "GuiderParameters",
      "MultimodalGuider",
      "ClownSampler_Beta",
      "SamplerCustomAdvanced",
      "LTXVSeparateAVLatent",
      "VAEDecode",
      "VHS_VideoCombine",
      "RandomNoise",
      "LTXVScheduler"
    ],
    "changelog": {
      "v7-v9": "STGGuiderAdvanced + latent video brut → hallucination (format tenseur incorrect)",
      "v10": "Tentative distilled — refuse par l'utilisateur",
      "v11": "Full path avec STGGuiderAdvanced — fade to black (pas de pipeline AV)",
      "v12.0.0": "Pipeline AV officiel + MultimodalGuider + GuiderParameters",
      "v12.1.0": "Switch LTXVGemmaCLIPModelLoader → LTXAVTextEncoderLoader (ComfyUI core). L'ancien loader produisait des embeddings avec normalisation RMSNorm incompatible — le modele attend le format global min-max + flag unprocessed_ltxav_embeds du core loader. Cause racine de l'hallucination systematique sur toutes les versions precedentes."
    }
  }
}
