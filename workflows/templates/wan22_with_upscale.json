{
  "name": "WAN 2.2 + Pyramid Upscale",
  "description": "Pipeline complet : génération + upscaling haute qualité",
  "version": "1.0.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["pipeline", "cinemagraph", "upscale", "complete"],
  
  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Image d'entrée"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Prompt de génération"
    },
    "steps_generation": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Steps pour la génération"
    },
    "steps_upscale": {
      "type": "integer",
      "default": 15,
      "min": 5,
      "max": 30,
      "description": "Steps pour l'upscaling"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "CFG scale"
    },
    "scale_factor": {
      "type": "float",
      "default": 2.0,
      "min": 1.5,
      "max": 4.0,
      "description": "Facteur d'upscaling"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 32,
      "description": "Nombre de frames"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 24,
      "description": "FPS de sortie"
    },
    "noise_level": {
      "type": "string",
      "default": "high",
      "enum": ["high", "low"],
      "description": "Niveau de bruit"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    },
    "width": {
      "type": "integer",
      "default": 832,
      "min": 64,
      "max": 3840
    },
    "height": {
      "type": "integer",
      "default": 480,
      "min": 64,
      "max": 2160
    }
  },
  
  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model": "{model_name}",
        "base_precision": "bf16",
        "quantization": "disabled",
        "load_device": "offload_device"
      }
    },
    "3": {
      "class_type": "WanVideoVAELoader",
      "inputs": {
        "model": ["2", 0]
      }
    },
    "4": {
      "class_type": "WanVideoTextEncode",
      "inputs": {
        "model": ["2", 0],
        "prompt": "{prompt}"
      }
    },
    "5": {
      "class_type": "WanVideoClipVisionEncode",
      "inputs": {
        "model": ["2", 0],
        "image": ["1", 0]
      }
    },
    "6": {
      "class_type": "WanVideoImageToVideoEncode",
      "inputs": {
        "width": "{width}",
        "height": "{height}",
        "num_frames": "{frames}",
        "noise_aug_strength": 0.0,
        "start_latent_strength": 1.0,
        "end_latent_strength": 1.0,
        "force_offload": true,
        "vae": ["3", 0],
        "clip_embeds": ["5", 0],
        "start_image": ["1", 0]
      }
    },
    "7": {
      "class_type": "WanVideoSampler",
      "inputs": {
        "model": ["2", 0],
        "image_embeds": ["6", 0],
        "steps": "{steps_generation}",
        "cfg": "{cfg_scale}",
        "shift": 5.0,
        "seed": "{seed}",
        "force_offload": true,
        "scheduler": "unipc",
        "riflex_freq_index": 0,
        "text_embeds": ["4", 0]
      }
    },
    "8": {
      "class_type": "WanVideoDecode",
      "inputs": {
        "vae": ["3", 0],
        "samples": ["7", 0],
        "enable_vae_tiling": false,
        "tile_x": 272,
        "tile_y": 272,
        "tile_stride_x": 144,
        "tile_stride_y": 128
      }
    },
    "9": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "RealESRGAN_x4plus.pth"
      }
    },
    "10": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": ["9", 0],
        "image": ["8", 0]
      }
    },
    "11": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_upscaled",
        "format": "video/h264-mp4",
        "pingpong": false,
        "save_output": true,
        "images": ["9", 0]
      }
    }
  },

  "outputs": {
    "video": {
      "node": "10",
      "output": 0,
      "description": "Cinemagraph upscalé"
    }
  },
  
  "metadata": {
    "comfyui_version": ">=0.2.0",
    "tags": ["pipeline", "cinemagraph", "upscale", "complete"],
    "required_nodes": [
      "LoadImage",
      "CheckpointLoaderSimple",
      "CLIPTextEncode",
      "VAEEncode",
      "VAEDecode",
      "KSampler",
      "UpscaleModelLoader",
      "VideoUpscale",
      "VHS_VideoCombine"
    ]
  }
}
