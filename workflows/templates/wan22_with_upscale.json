{
  "name": "WAN 2.2 + Pyramid Upscale",
  "description": "Pipeline complet : génération + upscaling haute qualité",
  "version": "1.0.0",
  "author": "Comfy_Img_to_Loop",
  "tags": ["pipeline", "cinemagraph", "upscale", "complete"],
  
  "parameters": {
    "input_image": {
      "type": "string",
      "required": true,
      "description": "Image d'entrée"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Prompt de génération"
    },
    "steps_generation": {
      "type": "integer",
      "default": 20,
      "min": 10,
      "max": 50,
      "description": "Steps pour la génération"
    },
    "steps_upscale": {
      "type": "integer",
      "default": 15,
      "min": 5,
      "max": 30,
      "description": "Steps pour l'upscaling"
    },
    "cfg_scale": {
      "type": "float",
      "default": 7.5,
      "min": 1.0,
      "max": 20.0,
      "description": "CFG scale"
    },
    "scale_factor": {
      "type": "float",
      "default": 2.0,
      "min": 1.5,
      "max": 4.0,
      "description": "Facteur d'upscaling"
    },
    "frames": {
      "type": "integer",
      "default": 16,
      "min": 8,
      "max": 32,
      "description": "Nombre de frames"
    },
    "fps": {
      "type": "integer",
      "default": 8,
      "min": 4,
      "max": 24,
      "description": "FPS de sortie"
    },
    "noise_level": {
      "type": "string",
      "default": "high",
      "enum": ["high", "low"],
      "description": "Niveau de bruit"
    },
    "seed": {
      "type": "integer",
      "default": -1,
      "min": -1,
      "description": "Seed pour reproductibilité (-1 = aléatoire)"
    }
  },
  
  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{input_image}"
      }
    },
    "2": {
      "class_type": "WanVideoModelLoader",
      "inputs": {
        "model": "wan2.2-i2v-a14b",
        "device": "cuda",
        "dtype": "bf16"
      }
    },
    "3": {
      "class_type": "WanVideoTextEncode",
      "inputs": {
        "model": ["2", 0],
        "prompt": "{prompt}"
      }
    },
    "4": {
      "class_type": "WanVideoTextEncode",
      "inputs": {
        "model": ["2", 0],
        "prompt": "static, frozen, blurry"
      }
    },
    "5": {
      "class_type": "WanVideoImageToVideoEncode",
      "inputs": {
        "model": ["2", 0],
        "image": ["1", 0]
      }
    },
    "6": {
      "class_type": "WanVideoSampler",
      "inputs": {
        "model": ["2", 0],
        "positive": ["3", 0],
        "negative": ["4", 0],
        "latent": ["5", 0],
        "steps": "{steps_generation}",
        "cfg": "{cfg_scale}",
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "seed": "{seed}"
      }
    },
    "7": {
      "class_type": "WanVideoDecode",
      "inputs": {
        "model": ["2", 0],
        "samples": ["6", 0]
      }
    },
    "8": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "RealESRGAN_x4plus.pth"
      }
    },
    "9": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": ["8", 0],
        "image": ["7", 0]
      }
    },
    "10": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "frame_rate": "{fps}",
        "loop_count": 0,
        "filename_prefix": "wan22_upscaled",
        "format": "video/h264-mp4",
        "pingpong": false,
        "save_output": true,
        "images": ["9", 0]
      }
    }
  },

  "outputs": {
    "video": {
      "node": "10",
      "output": 0,
      "description": "Cinemagraph upscalé"
    }
  },
  
  "metadata": {
    "comfyui_version": ">=0.2.0",
    "tags": ["pipeline", "cinemagraph", "upscale", "complete"],
    "required_nodes": [
      "LoadImage",
      "CheckpointLoaderSimple",
      "CLIPTextEncode",
      "VAEEncode",
      "VAEDecode",
      "KSampler",
      "UpscaleModelLoader",
      "VideoUpscale",
      "VHS_VideoCombine"
    ]
  }
}
