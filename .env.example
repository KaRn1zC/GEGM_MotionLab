# Configuration OwnCloud - Comfy_Img_to_Loop
# Copiez ce fichier en .env et remplissez vos identifiants

# Serveur OwnCloud (OBLIGATOIRE)
OWNCLOUD_SERVER_URL=https://your-owncloud-server.com
OWNCLOUD_USERNAME=your.email@example.com
OWNCLOUD_PASSWORD=your_password_or_app_token

# Dossier d'upload sur OwnCloud (OBLIGATOIRE)
OWNCLOUD_MODEL_FOLDER=/GEGM_ComfyUI/Models
OWNCLOUD_OUTPUT_FOLDER=/GEGM_ComfyUI/Outputs

# Choix du modèle d'IA
OWNCLOUD_MODEL_NAME=wan2.2-i2v-a14b  # ou wan2.2-ti2v-5b

# Configuration optionnelle (valeurs par défaut dans config/owncloud.yaml)
# OWNCLOUD_WEBDAV_PATH=/remote.php/webdav/
# OWNCLOUD_TIMEOUT=300
# OWNCLOUD_CHUNK_SIZE=8192
